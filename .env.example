# ZenMoney OAuth app credentials.
# Register an application at https://developers.zenmoney.ru (or .app) to obtain these.
# The app's redirect URI must be set to: http://localhost:${ZEN_REDIRECT_PORT}/callback
ZEN_CLIENT_ID=
ZEN_CLIENT_SECRET=

# Which ZenMoney server to use: "ru" or "app". Default: ru
ZEN_ENDPOINT=ru

# Local port for the OAuth callback during `zen-money-mcp auth`. Default: 53682
# This value must match the redirect URI registered for the app.
ZEN_REDIRECT_PORT=53682

# Optional: override where the cache DB and auth token are stored.
# Default: ~/.config/zen-money-mcp
# ZEN_DATA_DIR=
