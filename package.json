{
  "name": "zen-money-mcp",
  "version": "0.1.0",
  "description": "MCP server for ZenMoney: audit and fix transaction categories with historical context",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "zen-money-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "auth": "node build/index.js auth",
    "sync": "node build/index.js sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "16.6.1",
    "open": "11.0.0",
    "pdfjs-dist": "6.0.227",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "prettier": "3.8.4",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@11.5.1"
}
